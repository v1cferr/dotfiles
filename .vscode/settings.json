{
  // ═══════════════════════════════════════════════════════════════════════════
  // NIX IDE (jnoortheen.nix-ide): the config SPECIFIC TO THIS REPO.
  //
  // WHY HERE and not in the user's settings.json: the expressions below depend on the
  // workspace's root BEING this flake (the `./.` resolves to it) and they name the host
  // `nixos-kingston`. In the user's settings.json, which Settings Sync propagates, that
  // would hold for any Nix project opened, and in the others the `getFlake` would fail.
  // Here it stays versioned next to the flake it references. The `nix.enableLanguageServer`
  // toggle lives in the user's settings.json on purpose: it is independent of machine and
  // project, and it carries no path.
  //
  // A RELATIVE PATH, not an absolute one (fixed on 03/08/2026): `builtins.toString ./.`
  // resolves to the workspace's root. It is the form in nixd's official docs, and it was
  // VERIFIED here in a real LSP session (initialize plus didOpen plus completion): typing
  // `services.openss` returned `openssh` with both forms. The relative one is the one that
  // lasts: it survives moving the repo, cloning it at another path and another user. The
  // previous version had /home/v1cferr/... written three times.
  //
  // DO NOT REPEAT A DEFAULT: extension 0.5.13 already uses `nixd` as `nix.serverPath` and
  // `nixfmt` as `nix.formatterPath`, since the nix-community/vscode-nix-ide#433 issue
  // (nixpkgs-fmt deprecated) has been fixed. Redeclaring a default here would freeze the
  // choice against a future upstream improvement, which is the opposite of lasting.
  //
  // BINARIES BY NAME, resolved through the $PATH (nixd/nixfmt come from home/packages.nix).
  // NEVER put a /nix/store path here: the first `nix-collect-garbage` would delete the
  // target and the config would break in silence.
  //
  // TWO COUPLINGS that do not fail visibly: nixd just STOPS completing and it looks like
  // the extension got worse.
  //   1. `nixos-kingston` is the host's name in the flake. Renaming the host breaks it. I
  //      preferred the explicit name over a `builtins.head (attrValues …)`: the head would
  //      survive the rename, but it would pick an ARBITRARY host the day there is a second
  //      one.
  //   2. `./.` is the WORKSPACE'S ROOT. Opening a subfolder of the repo as the workspace
  //      (instead of the root) makes the getFlake point at a directory with no flake.nix.
  // ═══════════════════════════════════════════════════════════════════════════
  "nix.serverSettings": {
    "nixd": {
      // The formatter the LSP calls on "Format Document". nixfmt is the OFFICIAL one since
      // RFC 166 (nixfmt 1.0 came out under the NixOS org); nixpkgs-fmt is DEPRECATED and
      // alejandra is an unofficial alternative. A choice aligned with nixpkgs.
      //
      // The `-` is NOT decorative: nixd sends the document over STDIN, and nixfmt 1.4 warns
      // "Bare invocation of nixfmt is deprecated. Use 'nixfmt -' for anonymous stdin.",
      // which is to say the form without `-` is on its way out. It was verified that the
      // output is identical either way, so using `-` is free today and avoids the day the
      // formatter simply stops answering on save.
      "formatting": { "command": ["nixfmt", "-"] },
      // It completes and documents `pkgs.*` with the SAME nixpkgs flake.lock pins, not some
      // channel on the machine. Without this nixd falls into a fallback and lies about
      // which package exists, which is worse than not completing.
      "nixpkgs": {
        "expr": "import (builtins.getFlake (builtins.toString ./.)).inputs.nixpkgs { }"
      },
      // nixd's real gain over nil: completing NixOS and home-manager OPTIONS with their type
      // and description, by actually evaluating the config instead of guessing from text.
      // Verified on 03/08/2026: 57 option groups in nixos, 38 in home-manager, and
      // `services.openss` giving `openssh` in a real LSP session.
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.nixos-kingston.options"
        },
        // home-manager is a NixOS MODULE here, so its options are not at the top of the
        // config: they come out of `home-manager.users`, whose type is a submodule, hence
        // the `getSubOptions []`. With a plain `.options.home-manager` only the wrapper's 3
        // options would come (users/useGlobalPkgs/…), not the hundreds inside.
        "home-manager": {
          "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.nixos-kingston.options.home-manager.users.type.getSubOptions []"
        }
      }
    }
  }
}
