# KEYBOARD: hands the system's layout (my.keyboard) to Hyprland as a generated Lua table.
# No note: the option and its reason are in modules/nixos/desktop/keyboard.nix.
{ osConfig, ... }:

let
  cfg = osConfig.my.keyboard;
in
{
  # Data for Hyprland: input.lua dofiles it and falls back to ABNT2 if it is missing.
  home.file.".config/theme/keyboard.lua".text = ''
    -- Generated by Nix (my.keyboard). Do NOT edit by hand; the source is modules/nixos/desktop/keyboard.nix.
    return {
      layout = "${cfg.layout}",
      variant = "${cfg.variant}",
    }
  '';
}
