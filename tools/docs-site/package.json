{
  "name": "docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "palette": "nix eval --json --file ../../modules/home/desktop/palette-presets.nix --apply 'p: { name = p.default; colors = p.presets.${p.default}; }' > palette.json",
    "predev": "pnpm palette && pnpm sources",
    "sources": "node scripts/build-sources.ts public/_source",
    "dev": "next dev",
    "build": "next build && node scripts/finish-export.ts",
    "check:nav": "node scripts/check-navigation.ts",
    "test": "node --test 'tests/*.test.ts'",
    "lint": "oxlint",
    "typecheck": "next typegen && tsc --noEmit",
    "pretypecheck": "pnpm palette"
  },
  "dependencies": {
    "fumadocs-core": "16.17.2",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.2",
    "lucide-react": "1.56.0",
    "mermaid": "12.2.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-force-graph-2d": "1.29.2",
    "shiki": "4.5.0",
    "vfile": "6.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "github-slugger": "2.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "unist-util-visit": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "source-map-js@<1.2.2": "1.2.2",
      "sharp": "-"
    }
  }
}
