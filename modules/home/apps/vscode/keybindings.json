// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+p",
        "command": "-workbench.action.quickOpen"
    },
    {
        "key": "ctrl+p",
        "command": "workbench.panel.chat",
        "when": "workbench.panel.chat.view.copilot.active"
    },
    {
        "key": "ctrl+alt+i",
        "command": "-workbench.panel.chat",
        "when": "workbench.panel.chat.view.copilot.active"
    },
    {
        "key": "shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001b\r"
        },
        "when": "terminalFocus"
    },
    // The work layout: claude on the left, the usage watch top right, a plain shell bottom right
    {
        "key": "ctrl+alt+l",
        "command": "runCommands",
        "args": {
            "commands": [
                "workbench.action.closeAllGroups",
                {
                    "command": "vscode.setEditorLayout",
                    "args": {
                        "orientation": 0,
                        "groups": [
                            { "size": 0.55 },
                            { "size": 0.45, "groups": [{}, {}] }
                        ]
                    }
                },
                {
                    "command": "workbench.action.createTerminalEditor",
                    "args": { "location": { "viewColumn": 1 } }
                },
                {
                    "command": "workbench.action.terminal.sendSequence",
                    "args": { "text": "claude\r" }
                },
                {
                    "command": "workbench.action.createTerminalEditor",
                    "args": { "location": { "viewColumn": 2 } }
                },
                {
                    "command": "workbench.action.terminal.sendSequence",
                    "args": { "text": "claude-usage\r" }
                },
                {
                    "command": "workbench.action.createTerminalEditor",
                    "args": { "location": { "viewColumn": 3 } }
                },
                "workbench.action.focusFirstEditorGroup"
            ]
        }
    }
]