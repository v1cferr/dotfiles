@@ -0,0 +1,17 @@
+#pragma once
+
+#include <QImage>
+#include <QMimeType>
+#include <QSize>
+#include <QString>
+#include <QThreadPool>
+
+// Whether renderXdgFileThumbnail can produce a thumbnail for this type.
+bool xdgFileThumbnailSupported(const QMimeType &mime);
+
+// Reads the freedesktop thumbnail cache (~/.cache/thumbnails), generating and storing the entry on a
+// miss, so other applications reuse it. Blocking: run it on xdgThumbnailPool(), never on the GUI thread.
+QImage renderXdgFileThumbnail(const QString &path, const QSize &size);
+
+// Kept apart from the decoding pool, so a slow generator never stalls icon rendering.
+QThreadPool &xdgThumbnailPool();
