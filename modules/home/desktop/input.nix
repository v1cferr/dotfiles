# INPUT: hands the system's keyboard layout and touchpad choices to Hyprland as generated Lua.
# No note: the options and their reason are in modules/nixos/desktop/input.nix.
{ lib, osConfig, ... }:

let
  cfg = osConfig.my.keyboard;
  touchpad = osConfig.my.touchpad;
in
{
  # Data for Hyprland: input.lua dofiles it and falls back to ABNT2 if it is missing.
  home.file.".config/theme/keyboard.lua".text = ''
    -- Generated by Nix (my.keyboard). Do NOT edit by hand; the source is modules/nixos/desktop/input.nix.
    return {
      layout = "${cfg.layout}",
      variant = "${cfg.variant}",
    }
  '';

  home.file.".config/theme/touchpad.lua".text = ''
    -- Generated by Nix (my.touchpad). Do NOT edit by hand; the source is modules/nixos/desktop/input.nix.
    return {
      natural_scroll = ${lib.boolToString touchpad.naturalScroll},
      tap_to_click = ${lib.boolToString touchpad.tapToClick},
    }
  '';
}
