# nix build symlinks (nix build / nixos-rebuild build)
result
result-*

# PNGs ignored by default (loose screenshots). The lockscreen's wallpapers now come from
# pkgs.nixos-artwork (declarative), they are not versioned here anymore.
*.png
# the local Vicinae extension's icon: its manifest needs a PNG (the Nerd Font repo glyph)
!modules/home/desktop/vicinae/repositories/assets/icon.png

*.env
# generated by git-hooks.nix (the devShell installs the hook), so it is not versioned
.pre-commit-config.yaml

# the direnv/nix-direnv cache
.direnv/

# python bytecode: router-sync.py once ran from a scripts/ folder, and its cache got COMMITTED
__pycache__/
*.py[cod]

# the OVMF variable store QEMU writes in the CWD on every `nix run .#disko-vm` (the layout drill)
*-efi-vars.fd

# what building the site writes. The versioned artifact is the SOURCE (docs/ + tools/docs-site/); the
# build belongs to the derivation and to Pages, never to git.
/tools/docs-site/node_modules/
/tools/docs-site/.next/
/tools/docs-site/.source/
/tools/docs-site/out/
# the palette, GENERATED from modules/home/desktop/palette-presets.nix (`pnpm palette`, or the derivation)
/tools/docs-site/palette.json
# both REGENERATED by `next build`: next-env.d.ts even points into .next/, which is ignored above.
/tools/docs-site/next-env.d.ts
*.tsbuildinfo
