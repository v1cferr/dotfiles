# nix build symlinks (nix build / nixos-rebuild build)
result
result-*

# PNGs ignored by default (loose screenshots). The lockscreen's wallpapers now come from
# pkgs.nixos-artwork (declarative), they are not versioned here anymore.
*.png

*.env
# generated by git-hooks.nix (the devShell installs the hook), so it is not versioned
.pre-commit-config.yaml

# the direnv/nix-direnv cache
.direnv/

# python bytecode: router-sync.py runs from ./scripts, and the cache got COMMITTED once
__pycache__/
*.py[cod]

# the OVMF variable store QEMU writes in the CWD on every `nix run .#disko-vm` (the layout drill)
*-efi-vars.fd
