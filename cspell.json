// Corretor ortográfico (cSpell) DESTE repo. Lido como JSONC (aceita comentários).
{
  "version": "0.2",
  "language": "en,pt-BR", // inglês + português do Brasil
  // Escopo: só markdown (inteiro) + comentários com '#'. O '*' pega qualquer arquivo e
  // restringe a checagem às linhas de comentário (# no início OU após espaço — assim não
  // pega hex em string tipo "#1a1b26"). markdown sobrescreve com regex "match-tudo" p/
  // checar o arquivo inteiro (vale tanto se o cSpell mesclar quanto se substituir a lista).
  "languageSettings": [
    { "languageId": "*", "includeRegExpList": ["/(^|\\s)#.*/gm"] },
    { "languageId": "markdown", "includeRegExpList": ["/[\\s\\S]+/g"] }
  ],
  // Jargão técnico / nomes próprios que aparecem nos comentários — pra não virar "erro".
  // Português comum já vem do dicionário pt-BR; aqui só o que ele não conhece.
  "words": [
    "nixos", "nixpkgs", "flake", "flakes", "hostname", "declarativo", "declarativa",
    "hyprctl", "hyprland", "hyprlock", "hypridle", "hyprsunset", "hyprpaper", "hyprcursor",
    "waybar", "wofi", "rofi", "dolphin", "kitty", "mako", "dunst", "cliphist", "flameshot",
    "grim", "slurp", "thunar", "blueman", "quickshell", "greetd", "submap", "dispatcher",
    "dispatchers", "keybind", "keybinds", "keybindings", "launcher", "compositor", "autostart",
    "workspace", "workspaces", "wayland", "xwayland", "dpms", "gamma", "backlight", "ddcutil",
    "wireplumber", "wpctl", "pamixer", "pavucontrol", "playerctl", "brightnessctl", "pipewire",
    "systemd", "systemctl", "journalctl", "loginctl", "activation", "specialisation",
    "libsecret", "kvantum", "adwaita", "bibata", "gsettings", "libnotify", "shellcheck",
    "btop", "htop", "zsh", "starship", "eza", "zoxide", "direnv", "tealdeer", "yazi", "fzf",
    "restic", "sops", "openconnect", "netextender", "ollama", "jellyfin", "qbittorrent",
    "cloudflare", "dyndns", "ddns", "fail2ban", "microcode", "zram", "bootloader", "udisks",
    "dropbox", "obsidian", "librewolf", "cferr", "sandisk", "kingston", "ufscar",
    "toolkit", "upstream", "symlink", "idempotente", "wttr", "pango", "abnt"
  ]
}
