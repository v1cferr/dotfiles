  "terminal.integrated.defaultProfile.linux": "zsh", // It turns the GitLens Launchpad indicator off
  // Pinned tabs: it prevents closing by keyboard AND mouse (so the pins are not lost by accident)
  "workbench.editor.preventPinnedEditorClose": "keyboardAndMouse",
  // It keeps the pinned tabs on a separate row at the top, always fixed to the left
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  // It always reopens the last session's windows/folders (it goes back to where you stopped)
  "window.restoreWindows": "all",
  // Zoom for the WHOLE UI (Ctrl+= / Ctrl+- / Ctrl+0), not just the editor. The default
  // zoomPerWindow=true makes the zoom valid only in the current window and does NOT persist it;
  // with false it goes back to being global and VS Code writes `window.zoomLevel` HERE, which is
  // to say the zoom becomes versioned along with the rest. Each step is ~20% (zoomLevel 1 is
  // about 120%).
  "window.zoomPerWindow": false,
  // It keeps unsaved files when closing the window or exiting (so no work is lost)
  "files.hotExit": "onExitAndWindowClose",
  // It does not open the welcome screen at startup
  "workbench.startupEditor": "none",
  "chat.viewSessions.orientation": "stacked",
  "git.ignoreRebaseWarning": true,
  // The new UI (floating/rounded panels, a compact activity and status bar). The default is
  // false and the normal way it gets enabled is through an MS EXPERIMENT (experiment.mode
  // "auto"), which draws lots per machine, which is why Windows had it and Linux did not, on the
  // SAME version. Explicit here = it holds on both and does not depend on the draw. It is
  // `experimental`, so it may disappear.
  "workbench.experimental.modernUI": true,
