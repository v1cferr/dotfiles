{
  // ═══════════════════════════════════════════════════════════════════════════
  // NIX IDE (jnoortheen.nix-ide) — config ESPECÍFICA DESTE REPO.
  //
  // POR QUE AQUI e não no settings.json do usuário: as expressões abaixo dependem de
  // que a raiz do workspace SEJA este flake (o `./.` resolve pra ela) e nomeiam o host
  // `nixos-kingston`. No settings.json do usuário, que o Settings Sync propaga, isso
  // valeria pra qualquer projeto Nix aberto — e nos outros o `getFlake` falharia.
  // Aqui fica versionado ao lado do flake que referencia. O toggle
  // `nix.enableLanguageServer` mora no settings.json do usuário de propósito: é
  // independente de máquina e de projeto, e não carrega caminho nenhum.
  //
  // CAMINHO RELATIVO, não absoluto (corrigido em 03/08/2026): `builtins.toString ./.`
  // resolve pra raiz do workspace — é a forma da doc oficial do nixd, e VERIFICADA
  // aqui numa sessão LSP de verdade (initialize + didOpen + completion): digitar
  // `services.openss` devolveu `openssh` com as duas formas. A relativa é a que dura:
  // sobrevive a mover o repo, a clonar em outro caminho e a outro usuário. A versão
  // anterior tinha /home/v1cferr/... escrito três vezes.
  //
  // NÃO REPETIR DEFAULT: a extensão 0.5.13 já usa `nixd` como `nix.serverPath` e
  // `nixfmt` como `nix.formatterPath` — o issue nix-community/vscode-nix-ide#433
  // (nixpkgs-fmt depreciado) já foi corrigido. Redeclarar default aqui congelaria a
  // escolha contra melhoria futura do upstream, que é o oposto de durar.
  //
  // BINÁRIOS POR NOME, resolvidos pelo $PATH (nixd/nixfmt vêm de home/packages.nix).
  // NUNCA colocar caminho do /nix/store aqui: o primeiro `nix-collect-garbage`
  // apagaria o alvo e a config quebraria em silêncio.
  //
  // ⚠️ DOIS ACOPLAMENTOS que não falham visivelmente — o nixd só PARA de completar e
  // parece que a extensão piorou:
  //   1. `nixos-kingston` é o nome do host no flake. Renomear o host quebra. Preferi o
  //      nome explícito a um `builtins.head (attrValues …)`: o head sobreviveria ao
  //      rename, mas escolheria host ARBITRÁRIO no dia em que houver um segundo.
  //   2. `./.` é a RAIZ DO WORKSPACE. Abrir uma subpasta do repo como workspace (em vez
  //      da raiz) faz o getFlake apontar pra um diretório sem flake.nix.
  // ═══════════════════════════════════════════════════════════════════════════
  "nix.serverSettings": {
    "nixd": {
      // Formatter que o LSP chama no "Format Document". nixfmt é o OFICIAL desde a
      // RFC 166 (nixfmt 1.0 saiu sob a org NixOS); nixpkgs-fmt está DEPRECIADO e o
      // alejandra é alternativa não-oficial. Escolha alinhada com o nixpkgs.
      //
      // O `-` NÃO é decorativo: o nixd manda o documento por STDIN, e o nixfmt 1.4
      // avisa "Bare invocation of nixfmt is deprecated. Use 'nixfmt -' for anonymous
      // stdin." — ou seja, a forma sem `-` está a caminho de sumir. Verificado que a
      // saída é idêntica nas duas, então usar `-` é de graça hoje e evita o dia em que
      // o formatter simplesmente para de responder no save.
      "formatting": { "command": ["nixfmt", "-"] },
      // Completa e documenta `pkgs.*` com o MESMO nixpkgs que o flake.lock fixa, não
      // um canal qualquer da máquina. Sem isto o nixd cai num fallback e mente sobre
      // qual pacote existe — pior que não completar.
      "nixpkgs": {
        "expr": "import (builtins.getFlake (builtins.toString ./.)).inputs.nixpkgs { }"
      },
      // O ganho real do nixd sobre o nil: completar OPÇÕES de NixOS e home-manager
      // com tipo e descrição, avaliando a config de verdade em vez de adivinhar por
      // texto. Verificado em 03/08/2026: 57 grupos de options no nixos, 38 no
      // home-manager, e `services.openss` → `openssh` numa sessão LSP real.
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.nixos-kingston.options"
        },
        // home-manager é MÓDULO do NixOS aqui, então as options dele não estão no
        // topo da config: saem de `home-manager.users`, cujo tipo é submódulo — daí o
        // `getSubOptions []`. Com `.options.home-manager` puro viriam só as 3 opções
        // do wrapper (users/useGlobalPkgs/…), não as centenas de dentro.
        "home-manager": {
          "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.nixos-kingston.options.home-manager.users.type.getSubOptions []"
        }
      }
    }
  }
}
