# HYPRGLASS: the Liquid Glass plugin, built against the session's own compositor and handed to the
# Lua through a generated file. Off until switched on: docs/notes/desktop/hyprglass.md
{
  config,
  lib,
  osConfig,
  pkgs,
  ...
}:

let
  # Re-pinned to the EXACT Hyprland the session runs: a plugin built for another one pauses itself.
  plugin = pkgs.hyprglass.override { hyprland = osConfig.programs.hyprland.package; };
in
{
  options.my.hypr.hyprglass.enable = lib.mkOption {
    type = lib.types.bool;
    default = false;
    description = "Load the HyprGlass plugin into Hyprland (Perceptible Glass on the terminal, floating windows and the shell). Off by default: switching it on loads a plugin into the running compositor, so follow docs/notes/desktop/hyprglass.md.";
  };

  # Data for Hyprland: glass.lua loads the plugin only when this names it, and the plugin is only
  # built when it is on, so the off state costs nothing.
  config.home.file.".config/theme/plugins.lua".text = ''
    -- Generated by Nix (my.hypr.hyprglass). Do NOT edit by hand; the source is modules/home/desktop/hyprglass.nix.
    return {
      hyprglass = ${
        if config.my.hypr.hyprglass.enable then "\"${plugin}/lib/libhyprglass.so\"" else "nil"
      },
    }
  '';
}
