// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+p",
        "command": "-workbench.action.quickOpen"
    },
    {
        "key": "ctrl+p",
        "command": "workbench.panel.chat",
        "when": "workbench.panel.chat.view.copilot.active"
    },
    {
        "key": "ctrl+alt+i",
        "command": "-workbench.panel.chat",
        "when": "workbench.panel.chat.view.copilot.active"
    },
    {
        "key": "shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001b\r"
        },
        "when": "terminalFocus"
    },
    // The work layout: claude on the left, the usage watch top right, a plain shell bottom right
    {
        "key": "ctrl+alt+l",
        "command": "runCommands",
        "args": {
            "commands": [
                "workbench.action.closeAllGroups",
                // Each group is created and focused first, then the terminal opens IN it: a
                // viewColumn target raced the layout and piled every terminal into one row
                "workbench.action.createTerminalEditorSameGroup",
                {
                    "command": "workbench.action.terminal.sendSequence",
                    "args": { "text": "claude\r" }
                },
                "workbench.action.newGroupRight",
                "workbench.action.createTerminalEditorSameGroup",
                {
                    "command": "workbench.action.terminal.sendSequence",
                    "args": { "text": "claude-usage\r" }
                },
                "workbench.action.newGroupBelow",
                "workbench.action.createTerminalEditorSameGroup",
                "workbench.action.focusFirstEditorGroup"
            ]
        }
    }
]